[Unit]
Description=Restrict Rotta 12 PocketBase to the Cloudflare connector
After=docker.service network-online.target
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/sh -c '/usr/sbin/iptables -C DOCKER-USER -s 192.168.1.10 -p tcp --dport 8090 -j ACCEPT 2>/dev/null || /usr/sbin/iptables -I DOCKER-USER 1 -s 192.168.1.10 -p tcp --dport 8090 -j ACCEPT'
ExecStart=/bin/sh -c '/usr/sbin/iptables -C DOCKER-USER -s 192.168.1.13 -p tcp --dport 8090 -j ACCEPT 2>/dev/null || /usr/sbin/iptables -I DOCKER-USER 2 -s 192.168.1.13 -p tcp --dport 8090 -j ACCEPT'
ExecStart=/bin/sh -c '/usr/sbin/iptables -C DOCKER-USER -p tcp --dport 8090 -j DROP 2>/dev/null || /usr/sbin/iptables -A DOCKER-USER -p tcp --dport 8090 -j DROP'

[Install]
WantedBy=multi-user.target
