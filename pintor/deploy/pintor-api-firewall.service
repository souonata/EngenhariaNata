[Unit]
Description=Restrict Pintor API container to the Cloudflare connector
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
Environment=PINTOR_CONNECTOR_IP=192.168.1.10
Environment=PINTOR_API_PORT=8765
ExecStart=/bin/sh /opt/pintor-api/deploy/apply-firewall.sh
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
